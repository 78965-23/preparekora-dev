{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "preparekora-dev-api",
  "main": "src/index.js",
  "compatibility_date": "2026-11-20",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "vars": {
    "BRAND": "Preparekora",
    "FIREBASE_PROJECT_ID": "preparekora-dev",
    "FIREBASE_DATABASE_URL": "https://preparekora-dev-default-rtdb.firebaseio.com",
    "TIME_ZONE": "Asia/Kolkata",
    "REVEAL_DELAY_HOURS": "6",
    "ID_SEQUENCE_START": "5"
  },
  "r2_buckets": [
    {
      "binding": "ASSETS_BUCKET",
      "bucket_name": "preparekora-assets"
    }
  ],
  "triggers": {
    "crons": [
      "*/1 * * * *"
    ]
  }
}
